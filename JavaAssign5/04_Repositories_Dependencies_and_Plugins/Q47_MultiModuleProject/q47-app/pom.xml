<?xml version="1.0" encoding="UTF-8"?>
<!-- Q47: CHILD module 2 - the application. Depends on the sibling module q47-core. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.javaassign5</groupId>
        <artifactId>q47-multi-module</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>q47-app</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- sibling module: no <version>, it comes from the parent's dependencyManagement -->
        <dependency>
            <groupId>com.javaassign5</groupId>
            <artifactId>q47-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.javaassign5.q47.app.GradeApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
