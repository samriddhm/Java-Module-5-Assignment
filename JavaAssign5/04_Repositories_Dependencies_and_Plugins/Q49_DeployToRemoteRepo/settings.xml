<?xml version="1.0" encoding="UTF-8"?>
<!--
    Q49: EXAMPLE of ~/.m2/settings.xml (copy the <servers> part into YOUR settings.xml).
    It stores credentials OUTSIDE the project, so they never end up in Git.

    Each <server><id> must match a <repository><id> in the pom's <distributionManagement>.
    Better: encrypt passwords with "mvn -ep" or use environment variables
    as below (Maven reads ${env.NAME}).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>company-releases</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
        <server>
            <id>company-snapshots</id>
            <username>${env.NEXUS_USER}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>
    </servers>
</settings>
