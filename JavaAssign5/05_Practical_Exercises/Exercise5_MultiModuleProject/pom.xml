<?xml version="1.0" encoding="UTF-8"?>
<!--
    Practical Exercise 5: Multi-module Maven project with SHARED dependencies in the parent pom.xml.

    ex5-library-system/               (this parent pom, packaging = pom)
    ├── ex5-model/     Book class                          -> no module dependencies
    ├── ex5-service/   LibraryService                      -> depends on ex5-model
    └── ex5-app/       LibraryApp (main) + JSON report     -> depends on ex5-service (+ Gson)

    What is shared from HERE:
      <dependencies>          commons-lang3 + JUnit 5   -> EVERY module gets them automatically
      <dependencyManagement>  Gson + internal modules    -> versions fixed here; modules opt in
      <pluginManagement>      plugin versions            -> one place to upgrade

    Build all (from this folder):   mvn clean install
    Run the app:                    mvn -q -pl ex5-app exec:java
    Or the fat jar:                 java -jar ex5-app/target/ex5-app-1.0.0-all.jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javaassign5</groupId>
    <artifactId>ex5-library-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Exercise 5 - Library System (parent)</name>

    <modules>
        <module>ex5-model</module>
        <module>ex5-service</module>
        <module>ex5-app</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- all library versions in ONE place -->
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <gson.version>2.10.1</gson.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <!-- (A) SHARED DEPENDENCIES: inherited by every child module, no need to repeat them -->
    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- (B) MANAGED VERSIONS: children that need these declare them WITHOUT <version> -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javaassign5</groupId>
                <artifactId>ex5-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javaassign5</groupId>
                <artifactId>ex5-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- (C) SHARED PLUGIN SETTINGS -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
