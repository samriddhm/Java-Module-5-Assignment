<?xml version="1.0" encoding="UTF-8"?>
<!--
    Q34: How do you add a dependency to a Maven project?
    Look at the <dependencies> section below. Each dependency is identified by its
    "coordinates": groupId + artifactId + version (GAV), plus an optional scope.

    Run:   mvn compile exec:java
    See the downloaded jars:  mvn dependency:tree
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javaassign5</groupId>
    <artifactId>q34-add-dependency</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Keeping versions in properties makes them easy to update in one place -->
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <gson.version>2.10.1</gson.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- 1) Apache Commons Lang: extra String utilities (default scope = compile) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <!-- 2) Google Gson: convert Java objects to/from JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- 3) JUnit 5: only needed to compile and run tests -> scope "test" -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Lets you run the app with "mvn compile exec:java" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.javaassign5.q34.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
